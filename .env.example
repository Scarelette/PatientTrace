# Copy to .env in the folder you run `patienttrace` from (it is read automatically), or export these.
# Live mode: utterance-network alignment and difference summaries use Claude Opus 5.5.
ANTHROPIC_API_KEY=
# Optional overrides
# METHOD_MODEL=claude-opus-5-5
# PATIENTTRACE_DATA=~/.cache/patienttrace/data
# PATIENTTRACE_HOME=~/.cache/patienttrace/state
# ANGEL_WORKER_URL=http://127.0.0.1:7900
