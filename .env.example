# Copy to .env in the folder you run `angel-demo` from (it is read automatically), or export these.
# Live mode: utterance-network alignment and difference summaries use Claude Opus 5.5.
ANTHROPIC_API_KEY=
# Optional overrides
# METHOD_MODEL=claude-opus-5-5
# ANGEL_DEMO_DATA=~/.cache/angel-demo/data
# ANGEL_DEMO_HOME=~/.cache/angel-demo/state
# ANGEL_WORKER_URL=http://127.0.0.1:7900
