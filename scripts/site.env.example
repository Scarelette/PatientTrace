# Copy to scripts/site.env (gitignored) and fill in for your cluster. Read by scripts/dev_serve.sh,
# scripts/serve_public.sh, scripts/live_worker.slurm, scripts/live_mode.sh and the server's worker autostart.
# Slurm options for the patient-model worker job (any left empty is not passed to sbatch):
PT_SBATCH_ACCOUNT=
PT_SBATCH_PARTITION=
PT_SBATCH_QOS=
# Python environment that has vLLM (pip install "patienttrace[gpu]"); default: python on PATH
PT_WORKER_PYTHON=
# Hugging Face cache for the model weights (about 16 GB); default: ~/.cache/huggingface
PT_HF_HOME=
# Extra library path some clusters need for the worker's Python (optional)
PT_LD_LIBRARY_PATH=
# A file with ANTHROPIC_API_KEY=... (or an Azure Foundry key) loaded into the server only, never printed (optional;
# a .env file in the repo root or the environment works too)
LIVE_SECRETS=
